# syntax=docker/dockerfile:1.7
#
# Production frontend image for FoodSafe.
#
# Difference from the development Dockerfile: instead of copying a static
# nginx.conf, this image installs docker/nginx.prod.conf.template into
# /etc/nginx/templates/. The nginx (nginx-unprivileged) base image runs
# /docker-entrypoint.d/20-envsubst-on-templates.sh at container start-up,
# which substitutes ${SSL_CERT_PATH} and ${SSL_KEY_PATH} (supplied via the
# environment in docker-compose.prod.yml) and writes the result to
# /etc/nginx/conf.d/default.conf before nginx starts.
#
# The build stage is byte-for-byte identical to the development Dockerfile so
# the production bundle matches what CI already validates.

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

# Remove the stock server block; the envsubst entrypoint regenerates
# /etc/nginx/conf.d/default.conf from the template below at start-up.
USER root
RUN rm -f /etc/nginx/conf.d/default.conf

# Install the TLS-enabled production template. The official entrypoint script
# processes every *.template file in /etc/nginx/templates/ and strips the
# suffix, so this becomes /etc/nginx/conf.d/default.conf at runtime.
COPY docker/nginx.prod.conf.template /etc/nginx/templates/default.conf.template

COPY --from=build /app/dist /usr/share/nginx/html

# Ensure the runtime user owns the paths the entrypoint writes to.
RUN chown -R nginx:nginx /etc/nginx/conf.d /usr/share/nginx/html
USER nginx

# 8080 = HTTP (redirect + /healthz); 8443 = HTTPS (all content).
EXPOSE 8080 8443

# Liveness uses the plain-HTTP /healthz endpoint, which never redirects.
HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
