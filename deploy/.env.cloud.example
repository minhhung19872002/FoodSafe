# FoodSafe cloud VM environment template.
# scripts/gcp/provision.sh generates the real /opt/foodsafe/.env on the VM
# with random secrets. Never commit the real .env.

# Images (Artifact Registry)
IMAGE_REPO=asia-southeast1-docker.pkg.dev/PROJECT_ID/foodsafe
IMAGE_TAG=latest

# Public URL — the VM static IP until a domain + TLS certificate exist.
PUBLIC_BASE_URL=http://VM_STATIC_IP

# Caddy edge proxy site address:
#   :80              → plain HTTP on the bare IP (no domain yet)
#   your.domain.vn   → automatic Let's Encrypt HTTPS (DNS A record must
#                      point at the VM before switching)
SITE_DOMAIN=:80

# Staging skips Production-only gates (SSL SMTP, real Turnstile keys,
# PostgreSQL SslMode, DataProtection PFX). Requirements to switch to
# Production are listed in deploy/README.md.
ASPNETCORE_ENVIRONMENT=Staging
REQUIRE_HTTPS_METADATA=false
POSTGRES_SSL_MODE=Disable

# Database
POSTGRES_DB=FoodSafe
POSTGRES_USER=foodsafe
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# MinIO
MINIO_ROOT_USER=foodsafe-minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# App secrets
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME
SEED_ADMIN_EMAIL=admin@foodsafe.local
SEED_ADMIN_PASSWORD=CHANGE_ME

# Seed Vietnamese demo data (businesses, licenses, inspections, reports...)
# across all modules on next migrator run. Idempotent; demo instances only.
SEED_ENABLE_DEMO_DATA=false

# Captcha — Turnstile test keys (always pass). Replace with real keys +
# CAPTCHA_EXPECTED_HOSTNAME for Production.
CAPTCHA_SITE_KEY=1x00000000000000000000AA
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
CAPTCHA_EXPECTED_HOSTNAME=localhost

# SMTP — required (SSL + credentials) before ASPNETCORE_ENVIRONMENT=Production.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USE_DEFAULT_CREDENTIALS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@foodsafe.local
SMTP_FROM_NAME=FoodSafe

# DataProtection certificate — required for Production only.
DATA_PROTECTION_CERTIFICATE_PATH=
DATA_PROTECTION_CERTIFICATE_PASSWORD=
