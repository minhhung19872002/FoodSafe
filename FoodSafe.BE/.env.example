POSTGRES_DB=FoodSafe
POSTGRES_USER=foodsafe
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

MINIO_ROOT_USER=foodsafe-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# The API creates and uses the private `foodsafe-files` bucket.
# ClamAV is internal-only and is not exposed on a host port.

STRING_ENCRYPTION_PASSPHRASE=replace-with-at-least-32-random-characters
# Development defaults use Cloudflare's published test keys. Production must
# use a real hostname-restricted Turnstile widget and secret.
CAPTCHA_SITE_KEY=1x00000000000000000000AA
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
CAPTCHA_EXPECTED_HOSTNAME=localhost

# Password-recovery delivery. Production must enable TLS and normally uses
# explicit credentials.
SMTP_FROM_ADDRESS=noreply@foodsafe.local
SMTP_FROM_NAME=FoodSafe
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_ENABLE_SSL=false
SMTP_USE_DEFAULT_CREDENTIALS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Required in Production; place the matching PFX at
# FoodSafe.BE/secrets/foodsafe-data-protection.pfx.
DATA_PROTECTION_CERTIFICATE_PASSWORD=
SEED_ADMIN_EMAIL=admin@foodsafe.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-bootstrap-password
PUBLIC_BASE_URL=http://localhost:8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Local Compose deliberately uses Development for HTTP cookie compatibility.
# Production must use Production, an HTTPS PUBLIC_BASE_URL, and metadata validation.
ASPNETCORE_ENVIRONMENT=Development
REQUIRE_HTTPS_METADATA=false
