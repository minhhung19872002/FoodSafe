POSTGRES_DB=FoodSafe
POSTGRES_USER=foodsafe
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

MINIO_ROOT_USER=foodsafe-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

STRING_ENCRYPTION_PASSPHRASE=replace-with-at-least-32-random-characters
# Required in Production; place the matching PFX at
# FoodSafe.BE/secrets/foodsafe-data-protection.pfx.
DATA_PROTECTION_CERTIFICATE_PASSWORD=
SEED_ADMIN_EMAIL=admin@foodsafe.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-bootstrap-password
PUBLIC_BASE_URL=http://localhost:8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Local Compose deliberately uses Development for HTTP cookie compatibility.
# Production must use Production, an HTTPS PUBLIC_BASE_URL, and metadata validation.
ASPNETCORE_ENVIRONMENT=Development
REQUIRE_HTTPS_METADATA=false
