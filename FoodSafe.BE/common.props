<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AbpVersion>9.3.7</AbpVersion>
    <MicrosoftNetVersion>9.0.5</MicrosoftNetVersion>
    <ScribanVersion>7.2.5</ScribanVersion>
    <NewtonsoftJsonVersion>13.0.4</NewtonsoftJsonVersion>
    <SQLitePclRawVersion>2.1.12</SQLitePclRawVersion>
    <MailKitVersion>4.16.0</MailKitVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AbpProjectType>app</AbpProjectType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
    <PropertyGroup>
      <NoWarn>$(NoWarn);0436</NoWarn>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*" />
  </ItemGroup>

  <!--
    Security pin (B-6 / CVE-2026-32933, GHSA-rvv3-g6hj-g44x): ABP 9.3.7 pulls
    AutoMapper 14.0.0 transitively, which has an uncontrolled-recursion DoS
    (StackOverflow on deeply nested graphs). First fixed in 15.1.1. We pin the
    latest 15.1.x directly so every project resolves the patched assembly.
    Compatible with Volo.Abp.AutoMapper 9.3.7 (dependency constraint is
    AutoMapper >= 14.0.0). Verified by full solution build + test suite.
  -->
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="15.1.3" />
  </ItemGroup>
</Project>
